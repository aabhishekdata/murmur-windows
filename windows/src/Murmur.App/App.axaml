<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Murmur.App.App"
             RequestedThemeVariant="Default">
  <!-- Default, not a fixed variant: the hub follows the system appearance. The floating bar
       does not — it is a dark object sitting on top of other people's windows, and it is dark
       in both themes on purpose. -->
  <!-- No Application.Styles here: the control theme is added in Initialize from
       Design/AppTheme, which the headless tests install too. -->

  <!-- Third interface, after the floating bar and the hub. The bar can be hidden and the hub
       can be closed; the tray is what is always there. Avalonia's TrayIcon maps to the Windows
       notification area and needs no extra package. -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray.ico" ToolTipText="Murmur — hold the push-to-talk key to dictate">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Murmur" Click="OnTrayShow" />
            <NativeMenuItem Header="Show floating bar" Click="OnTrayBar" />
            <NativeMenuItem Header="Copy last transcript" Click="OnTrayCopyLast" />
            <NativeMenuItem Header="Settings…" Click="OnTraySettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
