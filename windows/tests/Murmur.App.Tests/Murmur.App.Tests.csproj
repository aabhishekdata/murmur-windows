<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1716;CA1062;CA1034</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- 11.3.x pairs with xUnit v2. The 12.x line requires xUnit v3, a different and
         incompatible package family. -->
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Real rasterisation, not the headless no-op drawing backend. This is what makes
         CaptureRenderedFrame return actual pixels, which is what makes the screenshots in
         artifacts/ui-preview a genuine review of the UI rather than a picture of nothing.
         Inter is referenced for the same reason: a headless Linux runner has no system fonts
         to fall back on, and text would silently render as blanks. -->
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.App\Murmur.App.csproj" />
    <ProjectReference Include="..\..\src\Murmur.Testing\Murmur.Testing.csproj" />
  </ItemGroup>
</Project>
